# 天链V3 - 测试环境配置

# API 基础路径
VITE_API_BASE_URL=http://localhost:8000/api

# 环境
VITE_ENV=test
NODE_ENV=test

# 认证相关
VITE_TOKEN_KEY=admin_token
VITE_USER_KEY=admin_user

# 测试超时 (ms)
VITE_TEST_TIMEOUT=10000

# Mock 数据开关
VITE_USE_MOCK_DATA=true

# Playwright E2E 配置
E2E_BASE_URL=http://localhost:5173

# Coverage 配置
COVERAGE_THRESHOLD_LINES=30
COVERAGE_THRESHOLD_FUNCTIONS=30
COVERAGE_THRESHOLD_BRANCHES=20
COVERAGE_THRESHOLD_STATEMENTS=30