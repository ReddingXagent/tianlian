# 前端环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ========== API配置 ==========

# API基础URL (REST API)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket基础URL (统一前缀 /ws/v1/)
# 开发环境: ws://localhost:8000/ws/v1
# 生产环境: wss://your-domain.com/ws/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws/v1

# ========== WebSocket连接参数 ==========

# 心跳间隔(秒) - 防止连接断开
VITE_WS_HEARTBEAT_INTERVAL=30

# 重连间隔(秒) - 自动重连延迟
VITE_WS_RECONNECT_INTERVAL=3

# 最大重连次数 - 失败后停止重连
VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# 连接超时(秒) - 连接超时时间
VITE_WS_CONNECTION_TIMEOUT=10

# ========== 应用信息 ==========

VITE_APP_NAME=天链光储充运维系统V3
VITE_APP_VERSION=3.0.0

# ========== 调试配置 ==========

# 开发环境开启调试
VITE_DEBUG=true

# ========== 注意事项 ==========

# 1. 生产环境必须使用 wss:// (WebSocket Secure)
# 2. 确保 VITE_WS_BASE_URL 与后端路由前缀一致
# 3. WebSocket端点标准化后统一使用 /ws/v1/ 前缀
# 4. 不要在此文件中存储敏感信息(密码、密钥等)