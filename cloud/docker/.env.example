# ═══════════════════════════════════════════════════════════════
#  天链V3 - Docker 部署环境变量
#  复制为 .env 并修改敏感值
# ═══════════════════════════════════════════════════════════════
#   cp docker/.env.example docker/.env
#   docker compose --env-file docker/.env up -d
# ═══════════════════════════════════════════════════════════════

# ─── 应用 ───
APP_NAME=天链光储充运维系统
APP_VERSION=3.0.0
DEBUG=false
LOG_LEVEL=INFO

# ─── 数据库 (⚠️ 生产环境请修改密码) ───
DB_TYPE=postgres
# ⚠️ 必须改为强随机密码；docker-compose 已改用 ${DB_PASSWORD:?} fail-fast 语法，
#    未设置或留空将导致 `docker compose up/config` 直接报错退出：
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DATABASE_URL=postgresql://tianlian:${DB_PASSWORD}@db:5432/tianlian_v3

# ─── JWT 密钥 (⚠️ 必须修改为随机字符串) ───
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── CORS 白名单 ───
CORS_ORIGINS=http://localhost:3004,http://localhost:80,http://localhost

# ─── Sentry 错误监控 (可选) ───
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ─── MQTT 配置 (可选) ───
# MQTT_BROKER=mqtt://mqtt:1883

# ─── TDengine 配置 (可选) ───
# TDENGINE_HOST=tdengine
# TDENGINE_PORT=6041

# ─── 上传限制 ───
MAX_FILE_SIZE=10485760

# ─── 监控栈 (docker-compose.monitoring.yml, ⚠️ 必须改密码) ───
# docker-compose.monitoring.yml 已改用 ${GRAFANA_ADMIN_PASSWORD:?} fail-fast：
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_GRAFANA_PASSWORD

# ─── HTTPS (生产环境) ───
# LETSENCRYPT_EMAIL=admin@example.com
# DOMAIN=tianlian.example.com