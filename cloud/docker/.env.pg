# ═══════════════════════════════════════════
#  天链V3 PostgreSQL 生产环境配置
#  由 scripts/setup-pg.sh 生成
# ═══════════════════════════════════════════

# ─── 应用 ───
APP_NAME=天链光储充运维系统
APP_VERSION=3.0.0
DEBUG=false

# ─── 服务器 ───
HOST=0.0.0.0
PORT=8080

# ─── 数据库 (PostgreSQL) ───
DB_TYPE=postgres
# ⚠️ 密码通过 DB_PASSWORD 环境变量注入 (docker-compose 用 ${DB_PASSWORD:-...} 兜底); 不再硬编码。
DB_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
DATABASE_URL=postgresql://tianlian:${DB_PASSWORD}@db:5432/tianlian_v3

# PostgreSQL 连接池 (生产推荐)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# ─── JWT ───
# ⚠️ 真实密钥必须在部署时由服务器生成注入 (如 openssl rand -base64 48), 严禁真实密钥入库。
SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Redis (可选, 生产推荐启用) ───
# REDIS_URL=redis://redis:6379/0

# ─── MQTT (可选) ───
# MQTT_BROKER=mqtt://mqtt:1883

# ─── Sentry 错误监控 (可选) ───
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ─── CORS 允许来源 ───
# ⚠️ 生产环境请修改为实际前端域名
CORS_ORIGINS=http://localhost:3004,http://localhost:80

# ─── 日志 ───
LOG_LEVEL=INFO

# ─── 上传 ───
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760