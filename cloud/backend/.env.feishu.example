# Phase19 IM告警通知配置示例
# 复制此文件为 .env 并填入真实值

# IM自定义机器人 Webhook URL（必需）
# 创建方式: IM群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人
IM_WEBHOOK_URL=https://open.im.cn/open-apis/bot/v2/hook/xxxxxxxx

# IM应用凭证（可选，用于高级功能如发送消息给特定用户）
IM_APP_ID=
IM_APP_SECRET=

# 告警通知用户 Open ID（可选，用于私聊通知）
IM_NOTIFY_USER_ID=

# 使用说明:
# 1. 在IM群中创建自定义机器人，获取 Webhook URL
# 2. 将 Webhook URL 设置到 IM_WEBHOOK_URL
# 3. Prometheus Alertmanager 告警会自动推送到该IM群
# 4. 系统内部严重告警（CRITICAL/FATAL）也会推送到IM