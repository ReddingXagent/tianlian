# 天链V3 backend 环境变量模板
# 复制为 .env 并填入实际值。deploy.sh 会保留生产 .env（备份→恢复），不会覆盖。

# JWT 签名密钥 (RFC 7518 §3.2): HMAC key 必须 ≥32 字节, 否则 PyJWT 抛
# InsecureKeyLengthWarning 且不满足合规。生产用强随机值:
#   openssl rand -hex 32   (生成 64 字节十六进制串)
SECRET_KEY=change-me-to-a-32-byte-or-longer-random-secret

# JWT 双 Key 灰度轮换 (卡 a89269c9, app/core/jwt_utils.py):
# 平滑更换 SECRET_KEY 且不使存量 token 失效。
#   SECRET_KEY_NEW  — 新密钥 (≥32 字节)。配置后新签发 token 改用它, 验证先试新 key;
#                    留空则不启用双 key, 退化为 SECRET_KEY 单 key (默认行为)。
#   SECRET_KEY_OLD  — 旧密钥。仅用于验证回退 (新 key 失败再试旧 key); 留空则回退到 SECRET_KEY。
# 轮换步骤: ① 配置 SECRET_KEY_NEW=新值 → ② 等存量 token 过期 → ③ 新值落到 SECRET_KEY,
#          清空 SECRET_KEY_NEW/OLD。详见 app/core/jwt_utils.py 注释。
# SECRET_KEY_NEW=
# SECRET_KEY_OLD=

# Pod 间通信共享密钥 (app/core/pod_security.py, fail-closed 设计):
# 未配置时 /api/v1/pod/*, /api/v1/cross/* 全部 403 拒绝。
# 请求头名: X-Pod-Secret。多 Pod 部署时各 Pod 必须共享同一值。
# 生产由 deploy.sh 自动 provisioning (openssl rand -hex 32)。
POD_COMM_SHARED_SECRET=

# 数据库连接 (app/core/database.py, 通过 DB_TYPE 切换):
# [卡439a1fcd] postgres 模式下未配置 DATABASE_URL 将 fail-fast 拒绝启动,
# 不再回退到任何硬编码凭证。复制为 .env 后按实际环境填入连接串。
DB_TYPE=sqlite
DATABASE_URL_DEV=sqlite:///./tianlian_v3.db
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/tianlian_v3

# JPush 极光推送 (卡 7f601f7f, app/services/push/jpush_provider.py):
# 凭证来自极光控制台 (AppKey + MasterSecret), 仅经环境变量注入。
# 三项齐备 (ENABLED=true 且两凭证非空) 时 App push 通道切真实 REST v3 推送;
# 留空则保持 LogPushProvider 日志降级 (开发/测试零配置可用)。
# 严禁将真实凭证写入代码/测试/日志。
# JIGUANG_ENABLED=false
# JIGUANG_APP_KEY=
# JIGUANG_MASTER_SECRET=

# IM-B服务商支付 (卡 6c8f930c A1, app/services/wx_pay/real_client.py):
# WX_PAY_MODE: mock(默认, 不联网零配置) | real(真实IM-B支付 v3, 凭证必填)。
# real 模式下任一凭证缺失 → 启动首调抛 WxPayError (fail-loud, 不静默回退 mock)。
# 凭证来自IM-B商户平台, 仅经环境变量注入, 严禁写入代码/日志。
# WX_PAY_MODE=mock
# WX_PAY_SP_MCHID=
# WX_PAY_PRIVATE_KEY_PATH=
# WX_PAY_CERT_SERIAL=
# WX_PAY_APIV3_KEY=
# WX_PAY_APPID_MINIPROGRAM=
# WX_PAY_APPID_APP=
# WX_PAY_NOTIFY_URL=
