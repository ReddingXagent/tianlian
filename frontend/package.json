{
  "name": "tianlian-v3-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run --coverage && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=html,json,list",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report test-results/html",
    "test:jest": "jest",
    "test:jest:coverage": "jest --coverage"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "antd": "^5.12.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.10",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.2",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "happy-dom": "^20.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "less": "^4.6.4",
    "msw": "^2.14.6",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.1"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.8",
    "fast-uri": "4.1.5",
    "form-data": "4.0.6",
    "js-yaml": "5.4.1",
    "postcss": "8.5.23",
    "undici": "7.30.0",
    "ws": "8.21.1"
  }
}
