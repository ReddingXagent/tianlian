{
  "name": "tianlian-user-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --verbose",
    "test:ci": "jest --verbose --ci --coverage --runInBand",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "deploy:check": "node scripts/deploy-check.js",
    "check:engine-strict": "bash scripts/check-engine-strict.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "axios": "^1.20.0",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.31",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "metro": "^0.81.5",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@sentry/.*)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.ts",
      "^expo-status-bar$": "<rootDir>/__mocks__/expo-status-bar.ts",
      "^react-native$": "<rootDir>/node_modules/react-native",
      "^react$": "<rootDir>/node_modules/react",
      "^@tianlian/shared-ui$": "<rootDir>/../tianlian-shared/shared-ui/src",
      "^@tianlian/shared-ui/(.*)$": "<rootDir>/../tianlian-shared/shared-ui/src/$1",
      "^@tianlian/shared-types$": "<rootDir>/../tianlian-shared/shared-types/src",
      "^@tianlian/shared-types/(.*)$": "<rootDir>/../tianlian-shared/shared-types/src/$1"
    },
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/types/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 99,
        "branches": 99,
        "functions": 99,
        "lines": 99
      }
    },
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "expo": {
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  }
}
