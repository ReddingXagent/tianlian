{
  "name": "tianlian-v3-user-mp",
  "version": "1.1.0",
  "description": "天链V3用户小程序",
  "scripts": {
    "check": "node scripts/check-mp-structure.js",
    "test": "jest --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:ci": "node scripts/lint-ci.js",
    "deploy": "node scripts/deploy.js",
    "deploy:check": "node scripts/deploy.js --check",
    "check:auth-keys": "node scripts/check-auth-keys.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "services/**/*.js",
      "utils/**/*.js",
      "config/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "miniprogram-ci": "^2.1.31"
  }
}
