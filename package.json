{
  "name": "tianlian-ops-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:android": "expo export --platform android",
    "build:ios": "expo export --platform ios",
    "build": "tsc --noEmit && expo export",
    "check:version": "bash scripts/check-app-version.sh",
    "check:alias": "bash scripts/check-alias-config.sh",
    "check:node": "bash scripts/check-node-version.sh",
    "check:guard-wiring": "bash scripts/check-guard-wiring.sh",
    "check:env-defaults": "bash scripts/check-env-defaults.sh",
    "check:unused-deps": "bash scripts/check-unused-deps.sh",
    "check:ci-parity": "bash scripts/check-ci-parity.sh",
    "check:engine-strict": "bash scripts/check-engine-strict.sh",
    "check:app-version-source": "bash scripts/check-app-version-source.sh",
    "check:expo-plugins": "bash scripts/check-expo-plugins-deps.sh",
    "check:updates-channel": "bash scripts/check-updates-channel.sh",
    "check:brand-color": "bash scripts/check-brand-color.sh",
    "check:build-number-parity": "bash scripts/check-build-number-parity.sh",
    "check:easignore-secrets": "bash scripts/check-easignore-secrets.sh",
    "check:unused-assets": "bash scripts/check-unused-assets.sh"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "axios": "^1.7.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "expo-doctor": "^1.20.1",
    "jest": "^29.7.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@sentry/.*)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/types/**"
    ]
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "expo": {
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  }
}
