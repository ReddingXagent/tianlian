{
  "name": "tianlian-station-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "build": "tsc --noEmit",
    "check:alias": "bash scripts/check-alias-config.sh",
    "check:test-liveness": "bash scripts/check-test-suite-liveness.sh",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "check:node": "bash scripts/check-node-version.sh",
    "check:engine-strict": "bash scripts/check-engine-strict.sh",
    "lint:ci": "eslint . --max-warnings=12"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.0.14",
    "@react-navigation/native": "^7.0.19",
    "@react-navigation/native-stack": "^7.0.4",
    "axios": "^1.19.0",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-chart-kit": "^6.12.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.31",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "react-native",
    "testTimeout": 15000,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@sentry/.*)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 99,
        "branches": 96,
        "functions": 98,
        "lines": 99
      }
    }
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit"
        ]
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}
