/* pages/coupons/coupons.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-color);
}

.tabs {
  display: flex;
  background: var(--bg-white);
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary);
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.claim-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-white);
  margin: 16rpx 0;
}

.claim-icon { font-size: 36rpx; margin-right: 12rpx; }
.claim-text { flex: 1; font-size: 28rpx; color: var(--text-primary); }
.claim-arrow { font-size: 32rpx; color: var(--text-faint); }

.claim-input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: var(--bg-white);
  margin-bottom: 16rpx;
}

.code-input {
  flex: 1;
  height: 64rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.claim-btn {
  background: var(--primary);
  color: var(--on-primary);
  border: none;
  font-size: 26rpx;
}

.claim-btn.disabled { opacity: 0.6; }

.coupon-list { padding: 0 32rpx; }

.coupon-card {
  display: flex;
  background: var(--bg-white);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.coupon-card.status-used,
.coupon-card.status-expired {
  opacity: 0.6;
}

.coupon-left {
  width: 200rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  color: var(--on-primary);
  position: relative;
}

.coupon-left::after {
  content: '';
  position: absolute;
  right: -16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  background: var(--bg-color);
  border-radius: 50%;
}

.coupon-amount {
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1.2;
}

.coupon-type {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

.coupon-right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.coupon-min {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.coupon-expire {
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 4rpx;
}

.coupon-use-btn {
  margin-top: 12rpx;
  background: var(--primary);
  color: var(--on-primary);
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  align-self: flex-start;
}

.coupon-status-tag {
  font-size: 24rpx;
  margin-top: 12rpx;
  align-self: flex-start;
}
