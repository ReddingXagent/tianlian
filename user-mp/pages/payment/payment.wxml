<!-- pages/payment/payment.wxml - 支付页 -->
<view class="container">
  <!-- 金额展示 -->
  <view class="amount-section">
    <text class="amount-label">支付金额</text>
    <view class="amount-value">
      <text class="amount-symbol">¥</text>
      <text class="amount-number">{{amount}}</text>
    </view>
  </view>

  <!-- 订单摘要 -->
  <view class="order-summary">
    <view class="summary-item">
      <text class="summary-label">订单编号</text>
      <text class="summary-value">{{orderId}}</text>
    </view>
    <view class="summary-item">
      <text class="summary-label">充电站点</text>
      <text class="summary-value">{{stationName}}</text>
    </view>
    <view class="summary-item">
      <text class="summary-label">充电电量</text>
      <text class="summary-value">{{energy}} kWh</text>
    </view>
    <view class="summary-item">
      <text class="summary-label">充电时长</text>
      <text class="summary-value">{{durationText}}</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="pay-methods">
    <view class="section-title">支付方式</view>

    <view class="pay-method active" bindtap="onSelectMethod" data-method="wechat">
      <view class="method-left">
        <text class="method-icon">💚</text>
        <text class="method-name">微信支付</text>
      </view>
      <view class="method-right">
        <text class="method-check">✓</text>
      </view>
    </view>

    <view class="pay-method" bindtap="onSelectMethod" data-method="wallet">
      <view class="method-left">
        <text class="method-icon">👛</text>
        <text class="method-name">钱包余额</text>
        <text class="method-balance">(余额 ¥{{balance}})</text>
      </view>
      <view class="method-right">
        <text class="method-check" wx:if="{{payMethod === 'wallet'}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 支付按钮 -->
  <view class="action-section safe-bottom">
    <button
      class="btn btn-primary btn-block"
      bindtap="onPay"
      loading="{{paying}}"
      disabled="{{paying}}"
    >
      {{paying ? '支付中...' : '确认支付 ¥' + amount}}
    </button>
  </view>
</view>
