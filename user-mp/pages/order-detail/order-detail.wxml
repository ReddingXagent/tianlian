<!-- pages/order-detail/order-detail.wxml - 订单详情 -->
<view class="container">
  <loading visible="{{loading}}" text="加载订单..." />

  <block wx:if="{{!loading && order}}">
    <!-- 订单状态 -->
    <view class="status-section {{order.statusClass}}">
      <text class="status-icon">{{order.statusIcon}}</text>
      <text class="status-title">{{order.statusText}}</text>
      <text class="status-desc" wx:if="{{order.statusDesc}}">{{order.statusDesc}}</text>
    </view>

    <!-- 充电数据 -->
    <view class="data-section">
      <view class="data-grid">
        <view class="data-item">
          <text class="data-label">充电电量</text>
          <text class="data-value">{{order.energy}} kWh</text>
        </view>
        <view class="data-item">
          <text class="data-label">充电时长</text>
          <text class="data-value">{{order.durationText}}</text>
        </view>
        <view class="data-item">
          <text class="data-label">平均功率</text>
          <text class="data-value">{{order.avgPower}} kW</text>
        </view>
        <view class="data-item">
          <text class="data-label">订单金额</text>
          <text class="data-value price">¥{{order.amount}}</text>
        </view>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="info-section">
      <view class="section-title">订单信息</view>
      <view class="info-list">
        <view class="info-item">
          <text class="info-label">订单编号</text>
          <text class="info-value">{{order.id}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">充电站点</text>
          <text class="info-value">{{order.stationName}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">充电桩编号</text>
          <text class="info-value">{{order.chargerId}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">开始时间</text>
          <text class="info-value">{{order.startTime}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">结束时间</text>
          <text class="info-value">{{order.endTime || '--'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">单价</text>
          <text class="info-value">{{order.price}} 元/度</text>
        </view>
        <view class="info-item">
          <text class="info-label">支付方式</text>
          <text class="info-value">{{order.payMethod || '--'}}</text>
        </view>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="info-section" wx:if="{{order.feeDetail}}">
      <view class="section-title">费用明细</view>
      <view class="info-list">
        <view class="info-item">
          <text class="info-label">电费</text>
          <text class="info-value">¥{{order.feeDetail.energyFee || '0.00'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">服务费</text>
          <text class="info-value">¥{{order.feeDetail.serviceFee || '0.00'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">优惠</text>
          <text class="info-value discount">-¥{{order.feeDetail.discount || '0.00'}}</text>
        </view>
        <view class="info-item total">
          <text class="info-label">合计</text>
          <text class="info-value price">¥{{order.amount}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section safe-bottom" wx:if="{{order.showPay}}">
      <button class="btn btn-primary btn-block" bindtap="onPay">
        立即支付 ¥{{order.amount}}
      </button>
    </view>
  </block>
</view>
