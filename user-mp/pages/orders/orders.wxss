/* pages/orders/orders.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-color);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  background: var(--bg-white);
  padding: 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.filter-tab.active {
  color: var(--primary);
  font-weight: 600;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  padding: 20rpx 24rpx;
}

/* 订单卡片 */
.order-card {
  background: var(--bg-white);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.order-station {
  flex: 1;
}

.station-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.charger-id {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 订单信息 */
.order-info {
  background: var(--bg-hover);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-muted);
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
}

.info-value.price {
  color: var(--danger);
  font-weight: 600;
}

/* 订单时间 */
.order-time {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--text-muted);
}
