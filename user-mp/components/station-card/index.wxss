/* components/station-card/index.wxss */
.station-card {
  background: var(--bg-white);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.station-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.station-distance {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--success-bg);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.station-address {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.station-info {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.info-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
}

.station-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.station-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.fav-btn {
  color: var(--danger);
  background: rgba(250, 81, 81, 0.1);
}

.fav-btn.outline {
  color: var(--text-muted);
  background: var(--bg-input);
}

/* 品牌标识 */
.station-brand {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.brand-icon {
  margin-right: 6rpx;
  font-size: 22rpx;
}

.brand-name {
  font-weight: 500;
}
