<!-- components/station-card/index.wxml - 站点卡片组件 -->
<view class="station-card" bindtap="onTap">
  <view class="card-header">
    <view class="station-name">{{station.name}}</view>
    <view class="station-distance" wx:if="{{station.distance !== undefined}}">
      {{distanceText}}
    </view>
  </view>

  <view class="station-address">
    <text class="iconfont icon-location"></text>
    <text>{{station.address}}</text>
  </view>

  <view class="station-info">
    <view class="info-item">
      <text class="info-label">充电桩</text>
      <text class="info-value">
        <text class="text-primary">{{station.available || 0}}</text>
        <text> / {{station.total || 0}}</text>
      </text>
    </view>
    <view class="info-item">
      <text class="info-label">价格</text>
      <text class="info-value text-primary">{{station.price || '0.00'}} 元/度</text>
    </view>
    <view class="info-item">
      <text class="info-label">类型</text>
      <text class="info-value">{{station.chargerType || '快充'}}</text>
    </view>
  </view>

  <view class="station-tags" wx:if="{{station.tags && station.tags.length}}">
    <text class="tag tag-success" wx:for="{{station.tags}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="station-actions">
    <view class="action-btn fav-btn" wx:if="{{station.isFavorited}}" catchtap="onUnfav">
      ❤️ 已收藏
    </view>
    <view class="action-btn fav-btn outline" wx:else catchtap="onFav">
      🤍 收藏
    </view>
  </view>
</view>
