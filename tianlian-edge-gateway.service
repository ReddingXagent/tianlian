# systemd unit — 天链V3 边缘网关
# 部署: sudo cp tianlian-edge-gateway.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now tianlian-edge-gateway
# 日志: journalctl -u tianlian-edge-gateway -f
#       (或 tail -f /home/tl/tianlian-edge-gateway-v3/gateway.log)
[Unit]
Description=Tianlian V3 Edge Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tl
WorkingDirectory=/home/tl/tianlian-edge-gateway-v3
ExecStart=/usr/bin/python3 /home/tl/tianlian-edge-gateway-v3/main.py
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3
EnvironmentFile=/home/tl/tianlian-edge-gateway-v3/.env
StandardOutput=append:/home/tl/tianlian-edge-gateway-v3/gateway.log
StandardError=append:/home/tl/tianlian-edge-gateway-v3/gateway.log

[Install]
WantedBy=multi-user.target
