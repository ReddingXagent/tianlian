# 天链V3 边缘网关 — 环境变量示例
# 复制为 .env 并填入真实值: cp .env.example .env

# --- 云端 ---
CLOUD_BASE_URL=http://8.134.106.166
CLOUD_TOKEN=<云端签发长期token, user=edge_gateway_telemetry>
CLOUD_USERNAME=
CLOUD_PASSWORD=
CLOUD_REGISTER=true
CLOUD_DEREGISTER=true
POD_SECRET=

# --- 网关标识 ---
GATEWAY_ID=GW-001
GATEWAY_NAME=RaspberryPi-Gateway

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=gateway-mqtt
MQTT_BATCH_SIZE=50
MQTT_BATCH_INTERVAL=10

# --- Modbus ---
MODBUS_HOST=127.0.0.1
MODBUS_PORT=502
MODBUS_REAL=false

# 设备名→云端ID映射(JSON, 可选; 留空用内置默认: modbus-1=1, CHARGER-001=2, GW-001=0)
# 例: DEVICE_ID_MAP_JSON={"modbus-1": 1, "CHARGER-001": 6}
DEVICE_ID_MAP_JSON=

# --- OCPP ---
OCPP_CHARGER_ID=CHARGER-001
OCPP_REAL=false

# --- 存储 / 日志 ---
STORAGE_DB_PATH=data/gateway.db
LOG_LEVEL=INFO
