# ─── 天链V3 环境变量示例 ───
# 复制此文件为 backend/.env 或 docker/.env.pg 后修改

# ═══════════════════════════════════════════
#  数据库切换指南
# ═══════════════════════════════════════════
# 支持两种数据库模式，通过 DB_TYPE 切换:
#
# 【SQLite】(默认, 适合开发/单机)
#   DB_TYPE=sqlite
#   DATABASE_URL_DEV=sqlite:///./tianlian_v3.db
#   无需额外安装，开箱即用
#   不支持并发写入，适合小规模
#
# 【PostgreSQL】(生产推荐)
#   DB_TYPE=postgres
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
#   需要先搭建 PostgreSQL:
#     ./scripts/setup-pg.sh            # 本地
#     ./scripts/setup-pg.sh --docker   # Docker
#   迁移数据:
#     python scripts/migrate_sqlite_to_pg.py
#   支持连接池、高并发、主从复制

# ============ 数据库 ============
# 数据库类型: sqlite (默认) | postgres
DB_TYPE=sqlite

# SQLite 路径 (DB_TYPE=sqlite 时生效)
DATABASE_URL_DEV=sqlite:///./tianlian_v3.db

# PostgreSQL 连接 (DB_TYPE=postgres 时生效)
# 格式: postgresql://用户:密码@主机:端口/数据库名
# 本地: postgresql://<user>:<password>@localhost:5432/tianlian_v3
# Docker: postgresql://<user>:<password>@db:5432/tianlian_v3
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/tianlian_v3
# [卡439a1fcd] postgres 模式未配置 DATABASE_URL 将 fail-fast 拒绝启动 (app/core/database.py)。

# PostgreSQL 连接池 (仅 postgres 模式)
# DB_POOL_SIZE=20       # 连接池大小 (默认20)
# DB_MAX_OVERFLOW=10    # 最大溢出连接 (默认10)
# DB_POOL_RECYCLE=3600  # 连接回收时间/秒 (默认3600=1小时)
# DB_POOL_PRE_PING=true # 使用前检查连接是否有效

# ============ 应用 ============
APP_NAME=天链光储充运维系统
APP_VERSION=3.0.0
DEBUG=false

# ============ 服务器 ============
HOST=0.0.0.0
PORT=8080

# ============ JWT ============
# ⚠️ 生产环境请务必修改！生成强密钥: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ Alertmanager Webhook 认证 (Phase17 安全加固 da16d511) ============
# POST /alert-webhook 校验共享密钥，防止伪造 critical 告警刷屏IM(通知通道 DoS)。
# 生成强密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 未配置(None/空)则端点拒绝所有 Alertmanager 请求(403)，生产必须配置。
# Alertmanager webhook_configs url 需携带 ?secret=<同值>，或请求头 X-Webhook-Secret。
ALERT_WEBHOOK_SECRET=change-me-to-a-random-webhook-secret

# ============ Redis (可选) ============
# 启用后加速限流、缓存、会话管理
# REDIS_URL=redis://localhost:6379/0

# ============ MQTT (可选) ============
# 用于设备实时通信
# MQTT_BROKER=mqtt://localhost:1883

# ============ Sentry (可选) ============
# 错误监控服务
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ============ CORS ============
# 允许的前端来源 (逗号分隔)
CORS_ORIGINS=http://localhost:3004,http://localhost:80

# ============ 日志 ============
# 可选: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============ 上传 ============
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760