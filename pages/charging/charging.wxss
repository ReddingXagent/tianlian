/* pages/charging/charging.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 状态头部 */
.charging-header {
  background: linear-gradient(135deg, #07C160, #06AD56);
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pulse-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffffff;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.3); }
}

.status-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 核心数据 */
.charging-data {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx;
}

.data-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.data-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
  display: block;
}

.data-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.data-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1;
}

.data-unit {
  font-size: 24rpx;
  color: #999999;
}

.power-card .data-number { color: #07C160; }
.energy-card .data-number { color: #1890FF; }
.cost-card .data-number { color: #FA5151; }
.time-card .data-number { color: #FF8C00; }

/* 充电进度 */
.progress-section {
  margin: 0 24rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.progress-percent {
  font-size: 36rpx;
  font-weight: 700;
  color: #07C160;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #07C160, #06AD56);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999999;
}

/* 详情 */
.detail-section {
  margin: 0 24rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #999999;
}

.detail-value {
  font-size: 26rpx;
  color: #333333;
}

/* 操作区 */
.action-section {
  padding: 24rpx;
}

.action-section .btn {
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}
