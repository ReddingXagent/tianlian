/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-color);
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  background: var(--bg-white);
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--bg-input);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  flex: 1;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.filter-toggle {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--primary);
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--primary);
  border-radius: 24rpx;
  white-space: nowrap;
}

.filter-icon { font-size: 28rpx; }

/* 筛选面板 */
.filter-panel {
  background: var(--bg-white);
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  width: 140rpx;
  flex-shrink: 0;
}

.filter-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.filter-option {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--bg-input);
}

.filter-option.active {
  color: var(--on-primary);
  background: var(--primary);
}

.filter-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.filter-reset-btn,
.filter-apply-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 32rpx;
  padding: 12rpx 0;
  text-align: center;
  line-height: 1.4;
}

.filter-reset-btn {
  background: var(--bg-input);
  color: var(--text-secondary);
  border: none;
}

.filter-apply-btn {
  background: var(--primary);
  color: var(--on-primary);
  border: none;
}

/* 地图 */
.map-container {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.map {
  width: 100%;
  height: 100%;
}

.locate-btn {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 72rpx;
  height: 72rpx;
  background: var(--bg-white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
  font-size: 32rpx;
}

.locate-btn:active {
  background: var(--divider);
}

/* 站点列表 */
.station-list {
  padding: 20rpx 24rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.list-count {
  font-size: 24rpx;
  color: var(--text-muted);
}
