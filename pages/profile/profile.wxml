<!-- pages/profile/profile.wxml - 我的 -->
<view class="container">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="user-avatar" bindtap="onLogin">
      <image
        wx:if="{{userInfo.avatarUrl}}"
        class="avatar-img"
        src="{{userInfo.avatarUrl}}"
        mode="aspectFill"
      />
      <text wx:else class="avatar-placeholder">👤</text>
    </view>
    <view class="user-info" bindtap="onLogin">
      <text class="user-name">{{userInfo.nickName || '点击登录'}}</text>
      <text class="user-phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
    </view>
  </view>

  <!-- 钱包卡片 -->
  <view class="wallet-card" bindtap="onWalletTap">
    <view class="wallet-header">
      <text class="wallet-title">我的钱包</text>
      <text class="wallet-arrow">›</text>
    </view>
    <view class="wallet-balance">
      <text class="balance-symbol">¥</text>
      <text class="balance-amount">{{wallet.balance || '0.00'}}</text>
    </view>
    <view class="wallet-actions">
      <button class="wallet-btn" bindtap="onRecharge" catchtap="onRecharge">充值</button>
      <button class="wallet-btn" bindtap="onCoupons" catchtap="onCoupons">
        优惠券
        <text class="coupon-count" wx:if="{{wallet.couponCount}}">{{wallet.couponCount}}</text>
      </button>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="onMyVehicles">
        <text class="menu-icon">🚗</text>
        <text class="menu-name">我的车辆</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMyOrders">
        <text class="menu-icon">📋</text>
        <text class="menu-name">充电记录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onPoints">
        <text class="menu-icon">🎁</text>
        <text class="menu-name">积分中心</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onTransactions">
        <text class="menu-icon">💳</text>
        <text class="menu-name">交易明细</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="onFavorites">
        <text class="menu-icon">⭐</text>
        <text class="menu-name">收藏站点</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onNotifications">
        <text class="menu-icon">🔔</text>
        <text class="menu-name">消息通知</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onHelp">
        <text class="menu-icon">❓</text>
        <text class="menu-name">帮助中心</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onFeedback">
        <text class="menu-icon">💬</text>
        <text class="menu-name">意见反馈</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="onSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-name">设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-name">关于天链</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 版本号 -->
  <view class="version-info">
    <text>天链充电 v1.0.0</text>
  </view>
</view>
