/* pages/payment/payment.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 金额区域 */
.amount-section {
  background: #ffffff;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.amount-label {
  font-size: 28rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
}

.amount-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.amount-symbol {
  font-size: 36rpx;
  color: #333333;
  font-weight: 600;
  margin-right: 4rpx;
}

.amount-number {
  font-size: 72rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1;
}

/* 订单摘要 */
.order-summary {
  margin: 0 24rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.summary-item:not(:last-child) {
  border-bottom: 1rpx solid #f5f5f5;
}

.summary-label {
  font-size: 26rpx;
  color: #999999;
}

.summary-value {
  font-size: 26rpx;
  color: #333333;
}

/* 支付方式 */
.pay-methods {
  margin: 0 24rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.pay-method {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.pay-method:last-child {
  margin-bottom: 0;
}

.pay-method.active {
  border-color: #07C160;
  background: #E8F8EF;
}

.method-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.method-icon {
  font-size: 36rpx;
}

.method-name {
  font-size: 28rpx;
  color: #333333;
}

.method-balance {
  font-size: 24rpx;
  color: #999999;
}

.method-right {
  /*  */
}

.method-check {
  font-size: 28rpx;
  color: #07C160;
  font-weight: 600;
}

/* 操作区 */
.action-section {
  padding: 24rpx;
}

.action-section .btn {
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}
